# AEGIS DAO - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file!

# ===========================================
# REQUIRED: Deployment Private Key
# ===========================================
# Export from MetaMask or use a dedicated deployment wallet
PRIVATE_KEY=your_private_key_here

# ===========================================
# RPC URLs (defaults provided, but dedicated URLs are faster)
# ===========================================
# Polygon Amoy Testnet
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Polygon Mainnet
POLYGON_RPC_URL=https://polygon-rpc.com

# Optional: Use Alchemy for better reliability
# AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ===========================================
# Contract Verification (Optional but recommended)
# ===========================================
# Get from https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ===========================================
# Governance Configuration
# ===========================================
# Timelock delay in seconds (default: 1 day = 86400)
TIMELOCK_DELAY=86400
